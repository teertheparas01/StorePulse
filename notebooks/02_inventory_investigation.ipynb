    "    print(f\"\\nStatus combinations in overlaps:\")\n",
    "    print(overlap_df.groupby(['Record 1 Status', 'Record 2 Status']).size())\n",
    "    print(f\"\\nSample overlaps:\")\n",
    "    print(overlap_df.head(20).to_string())"
