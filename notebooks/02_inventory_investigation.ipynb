    "# 4. STOCK STATUS ANALYSIS\n",
    "print(\"=== STOCK STATUS DISTRIBUTION ===\")\n",
    "print(inv['Stock Status'].value_counts())\n",
    "print(f\"\\nStock Status by Division:\")\n",
